# Deterministic line endings: the same commit must yield byte-identical files (and
# therefore identical published-asset hashes) in every fresh clone, regardless of the
# machine's core.autocrlf. LF everywhere; binaries exempt.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.xlsx binary
*.sqlite3 binary
*.pfx binary

# Vendor license and notice texts are reproduced VERBATIM from the packages they came
# with — they are legal documents, not project source, and their SHA-256 in
# LICENSE-INVENTORY.md is the vendor file's own hash. Normalising their line endings
# would both alter a legal text and make every regeneration dirty the tree.
ThirdPartyLicenses/** -text

