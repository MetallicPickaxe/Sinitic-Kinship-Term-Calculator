<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>UI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- Packaged installs resolve the WinAppSDK framework via the AppX manifest; the generated
         DeploymentManager auto-initializer only adds a repair convenience but kills identity-less
         hosts (vstest testhost) at module init. Keep it off so UI.dll stays loadable in tests. -->
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <!-- Product/output name. Set on the UI project only (a bare -p:AssemblyName would leak
         into ProjectReferences and collide with KinshipCalculator.Core in NuGet restore).
         PublishProductName overrides it when a publish wants a different exe name. -->
    <AssemblyName>SiniticKinshipTermCalculator</AssemblyName>
    <AssemblyName Condition="'$(PublishProductName)' != ''">$(PublishProductName)</AssemblyName>
    <!-- Reproducibility pins (release audit B2). A self-contained publish embeds the
         runtime pack, and the default TargetLatestRuntimePatch=true resolves "whatever
         patch exists today" — it drifted 10.0.9 -> 10.0.10 between two builds of the SAME
         commit and changed the shipped bytes. With this false, the runtime pack becomes a
         pure function of the pinned SDK (global.json, rollForward disable).
         NOTE: do NOT pin RuntimeFrameworkVersion here — the Windows SDK targets reuse that
         property for the Microsoft.Windows.SDK.NET.Ref PackageDownload and restore fails.
         The lock file freezes the rest of the NuGet graph. -->
    <!-- NOTE: no packages.lock.json. It oscillates here — the validation loop restores this
         project transitively (Test-Unit references it) WITHOUT a RuntimeIdentifier while
         the release publish restores it WITH win-x64, so the lock file rewrites itself
         between the two and permanently dirties the tree, disabling the dirty gate that
         protects the release. The graph is pinned by exact PackageReference versions, the
         KnownRuntimePack patch above and the pinned SDK, and it is RECORDED per release in
         LICENSE-INVENTORY.md (every resolved component + version), which the publish
         regenerates, diffs, ships and hashes into BUILDINFO. -->

  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- Reproducibility pin for the embedded runtime pack (release audit B2). The default
       "latest patch" resolution asked the feed what the newest patch was, so the SAME
       commit embedded 10.0.9 in one build and 10.0.10 in the next and the shipped bytes
       changed. Declaring the latest patch here makes the choice OURS: still a patched
       runtime (not the 10.0.0 base a blanket TargetLatestRuntimePatch=false would pin),
       but a fixed one. Bumping it is a deliberate edit, mirrored in
       Script\toolchain.lock.json which the publish script enforces.
       Note: RuntimeFrameworkVersion cannot be used for this — the Windows SDK targets
       reuse that property for the Microsoft.Windows.SDK.NET.Ref PackageDownload. -->
  <ItemGroup>
    <KnownRuntimePack Update="Microsoft.NETCore.App"
                      TargetFramework="net10.0"
                      LatestRuntimeFrameworkVersion="10.0.10" />
    <KnownRuntimePack Update="Microsoft.WindowsDesktop.App"
                      TargetFramework="net10.0"
                      LatestRuntimeFrameworkVersion="10.0.10" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1-RTM" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KinshipCalculator.Core\KinshipCalculator.Core.csproj" />
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <WebView2EnableCsWinRTProjection>True</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
  </PropertyGroup>
	
	<ItemGroup>
		<Reference Remove="Microsoft.Web.WebView2.Wpf" />
		<Reference Remove="Microsoft.Web.WebView2.WinForms" />
	</ItemGroup>

	<!--
		REMOVED: the CopyToDistribution target (release audit F1).

		It ran AfterTargets="Publish" and copied the freshly built exe + Lexicon straight
		into the repository-level Distribution\ — i.e. into the LIVE release directory,
		before Script\Publish-SingleFile.ps1 had even created its staging directory, and
		therefore entirely outside that script's transaction. Consequences proved by the
		audit: a publish that later failed (signing, or an injected fault) left the live
		package with a NEW exe next to the OLD manifest, and the fault-injection test —
		which only compared the manifest file's own hash and the file count — reported
		PASSED. It also produced a structurally invalid package on its own: no BUILDINFO,
		no licensing set, no manifest, no ZIP.

		No target may write Distribution\. The release directory is produced exclusively by
		Script\Publish-SingleFile.ps1, and only by an atomic rename once every artifact has
		been assembled, signed and hashed in staging. A Visual Studio publish now leaves its
		output in bin\...\publish\ (where it belongs) and does not touch the release path.
	-->

</Project>