<Window
    x:Class="UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:KinshipCalculator.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="Sinitic Kinship Term Calculator">

	<Grid x:Name="Root"  Padding="16" RowSpacing="12" DataContext="{x:Bind ViewModel, Mode=OneWay}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<StackPanel Orientation="Horizontal" Spacing="8">
			<TextBlock Text="Language:" VerticalAlignment="Center" />
			<ComboBox Width="160"
                      ItemsSource="{Binding Languages}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Key"
                      SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}" />
			<TextBlock Text="Gender:" VerticalAlignment="Center" />
			<ComboBox Width="120"
                      ItemsSource="{Binding GenderOptions}"
                      DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedGenderOption, Mode=TwoWay}" />
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
				<TextBlock Text="Origin:" VerticalAlignment="Center" />
				<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
					<RadioButton Content="Birth"
                                 IsChecked="{x:Bind ViewModel.IsBiologicalOrigin, Mode=TwoWay}" />
					<RadioButton Content="Adopted"
                                 IsChecked="{x:Bind ViewModel.IsAdoptiveOrigin, Mode=TwoWay}" />
					<RadioButton Content="Step"
                                 IsChecked="{x:Bind ViewModel.IsStepOrigin, Mode=TwoWay}" />
				</StackPanel>
			</StackPanel>
			<Button Content="Undo" Command="{Binding UndoCommand}" />
			<Button Content="Clear" Command="{Binding ClearCommand}" />
		</StackPanel>

		<StackPanel Grid.Row="1" Spacing="8">
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
				<TextBlock Text="Path" Style="{ThemeResource SubtitleTextBlockStyle}" />
				<Button Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding CopyPathCommand}"
                        ToolTipService.ToolTip="Copy path"
                        Padding="4"
                        MinWidth="32"
                        MinHeight="32">
					<SymbolIcon Symbol="Copy" />
				</Button>
			</StackPanel>
			<TextBlock Text="{Binding PathText}" TextWrapping="Wrap" />
			<!-- Layer 4, raw calibration: the chain exactly as entered, never simplified, so the
			     reader can confirm the engine understood the input. -->
			<TextBlock Text="{Binding RawChainText}" TextWrapping="Wrap" FontSize="12"
					   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
				<TextBlock Text="Result" Style="{ThemeResource SubtitleTextBlockStyle}" />
				<Button Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding CopyResultCommand}"
                        ToolTipService.ToolTip="Copy result"
                        Padding="4"
                        MinWidth="32"
                        MinHeight="32">
					<SymbolIcon Symbol="Copy" />
				</Button>
			</StackPanel>
			<TextBlock Text="{Binding ResultText}" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" />
			<TextBlock Text="{Binding StatusHint}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
			<InfoBar IsOpen="{Binding IsNotificationVisible}"
                     Severity="Success"
                     IsClosable="False"
                     Message="{Binding NotificationMessage}"
                     Margin="0,8,0,0" />
			<ScrollViewer Margin="0,8,0,0"
                          MaxHeight="200"
                          VerticalScrollBarVisibility="Auto">
				<ItemsControl ItemsSource="{Binding ResultOptions}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:ResultInterpretation">
							<Grid Margin="0,0,0,12">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Spacing="2">
									<TextBlock Text="Standard" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
									<TextBlock Text="{x:Bind StandardLabel}" FontWeight="SemiBold" />
								</StackPanel>

								<StackPanel Grid.Column="1" Spacing="4">
									<TextBlock Text="Other names" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
									<!-- K15/K16: CANDIDATES ONLY. Each chip carries the lexicon layer it
									     came from (南系 / 北系 / 通用口語 / user layer); the chosen answer
									     stays the standard term in the first column. Empty collection
									     renders nothing, so no visibility converter is needed. -->
									<ItemsControl ItemsSource="{x:Bind Variants}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:VariantChip">
												<Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
														BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
														BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,4">
													<TextBlock Text="{x:Bind Display}" FontSize="12" TextWrapping="Wrap" />
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>

								<StackPanel Grid.Column="2" Spacing="2">
									<!-- Layer 3, documentary chain: always present, never contracted. -->
									<TextBlock Text="Formal description" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
									<TextBlock Text="{x:Bind DescriptiveChain}" TextWrapping="Wrap" />
									<TextBlock Text="Structural path" FontSize="12" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
									<TextBlock Text="{x:Bind OfficialLabel}" TextWrapping="Wrap" Opacity="0.8" />
								</StackPanel>

								<TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="3"
                                           Text="{x:Bind Explanation}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Margin="0,2,0,0" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</StackPanel>

		<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
			<ListView  x:Name="TokensList" ItemsSource="{Binding TokenButtons}">
				<ListView.ItemsPanel>
					<ItemsPanelTemplate>
						<ItemsWrapGrid Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ListView.ItemsPanel>

				<ListView.ItemTemplate>
					<DataTemplate x:DataType="vm:TokenDisplay">
						<Button Content="{x:Bind Label}"
                                Width="110"
                                Height="64"
                                Margin="4"
                                Command="{x:Bind AppendCommand}"
                                CommandParameter="{x:Bind}" />
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</ScrollViewer>

		<TextBlock Grid.Row="3"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="Tap tokens to build a relationship path" />
	</Grid>
</Window>
