<?xml version="1.0" encoding="utf-8"?>
<!--
  One-click distribution profile. In Visual Studio: right-click the UI project ->
  Publish -> select "Distribution". Produces the same portable single-file exe plus the
  editable Lexicon folder that Script\Publish-SingleFile.ps1 produces from the command line;
  both funnel through the CopyToDistribution target in UI.csproj.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Single-file publish requires an UNPACKAGED app; the base .csproj leaves the package
         type unset and turns trimming on for non-Debug, both of which break here. -->
    <WindowsPackageType>None</WindowsPackageType>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishProductName>SiniticKinshipTermCalculator</PublishProductName>
  </PropertyGroup>
</Project>
